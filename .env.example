# Server-only. Required on Vercel preview and production.
# Leave unset for `next dev` to use the in-memory signaling store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public STUN servers used for address discovery.
NEXT_PUBLIC_STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302

# Server-only. Optional. Mints short-lived TURN credentials so peers on different
# networks can still open a direct connection. Leave unset to sync through the cloud copy.
# Cloudflare dashboard → Realtime → TURN → create a key.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
