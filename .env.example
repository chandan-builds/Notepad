# Server-only. Required on Vercel preview and production.
# Leave unset for `next dev` to use the in-memory signaling store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public STUN servers used for address discovery. No TURN credentials in v1.
NEXT_PUBLIC_STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
